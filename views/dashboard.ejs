<%- include('partials/header', { title: 'Dashboard - College Tracker', activeTab: 'dashboard', user: user }) %>

<!-- Sync Banner & ntfy config -->
<div class="bg-surface-card/90 border border-surface-border rounded-2xl p-4 sm:p-5 mb-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-xl shadow-black/20">
<div class="flex items-center gap-3.5">
<div class="w-10 h-10 rounded-xl bg-accent-cyan/15 text-accent-cyan flex items-center justify-center shrink-0 border border-accent-cyan/30">
<i class="w-5 h-5" data-lucide="network"></i>
</div>
<div>
<div class="flex items-center gap-2">
<h2 class="font-semibold text-white text-base">Auto-Sync Conduit</h2>
<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-mono tracking-wide font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          CLASSROOM + GMAIL
        </span>
</div>
<p class="text-xs text-slate-400 mt-0.5">Autonomous background polling cycles every 15 mins.</p>
</div>
</div>
<div class="flex items-center gap-2.5 w-full md:w-auto">
<div class="flex items-center gap-2 px-3 py-1.5 bg-surface-low rounded-xl border border-surface-border text-xs font-mono text-slate-300">
<i class="w-3.5 h-3.5 text-accent-amber" data-lucide="bell"></i>
<span>ntfy.sh/<strong class="text-white"><%= user.ntfy_topic %></strong></span>
<button class="text-slate-400 hover:text-white ml-1" onclick="copyNtfyTopic('<%= user.ntfy_topic %>')" title="Copy topic">
<i class="w-3.5 h-3.5" data-lucide="copy"></i>
</button>
</div>
</div>
</div>
<!-- Sorting & Filter Controls (Matching backend query params) -->
<form action="/dashboard" class="flex flex-wrap items-center justify-between gap-3 mb-6 bg-surface-low/80 p-3 rounded-xl border border-surface-border/70" id="filterForm" method="GET">
<!-- Sort Group -->
<div class="flex items-center gap-2">
<span class="text-xs font-mono uppercase tracking-wider text-slate-400 mr-1">Sort:</span>
<div class="inline-flex rounded-lg bg-surface-card p-1 border border-surface-border">
<button class="px-3 py-1 text-xs font-medium rounded-md transition-colors <%= sort === 'due' ? 'bg-primary text-white shadow-sm' : 'text-slate-400 hover:text-white' %>" onclick="setSort('due')" type="button">
        Due Date
      </button>
<button class="px-3 py-1 text-xs font-medium rounded-md transition-colors <%= sort === 'subject' ? 'bg-primary text-white shadow-sm' : 'text-slate-400 hover:text-white' %>" onclick="setSort('subject')" type="button">
        Subject
      </button>
<button class="px-3 py-1 text-xs font-medium rounded-md transition-colors <%= sort === 'faculty' ? 'bg-primary text-white shadow-sm' : 'text-slate-400 hover:text-white' %>" onclick="setSort('faculty')" type="button">
        Faculty
      </button>
</div>
<input id="sortInput" name="sort" type="hidden" value="<%= sort %>"/>
</div>
<!-- Filter Dropdowns -->
<div class="flex items-center gap-3">
<!-- Subject Filter -->
<select class="bg-surface-card border border-surface-border text-slate-200 text-xs rounded-lg px-3 py-1.5 focus:outline-none focus:border-primary" name="subject" onchange="document.getElementById('filterForm').submit()">
<option value="">All Subjects</option>
      <% subjects.forEach(sub => { %>
        <option value="<%= sub %>" <%= subjectFilter === sub ? 'selected' : '' %>><%= sub %></option>
      <% }) %>
    </select>
<!-- Faculty Filter -->
<select class="bg-surface-card border border-surface-border text-slate-200 text-xs rounded-lg px-3 py-1.5 focus:outline-none focus:border-primary" name="faculty" onchange="document.getElementById('filterForm').submit()">
<option value="">All Faculty</option>
      <% faculties.forEach(fac => { %>
        <option value="<%= fac %>" <%= facultyFilter === fac ? 'selected' : '' %>><%= fac %></option>
      <% }) %>
    </select>
</div>
</form>
<!-- Four Dashboard Sections (from server.js CATEGORY_SECTIONS) -->
<div class="space-y-8">
  <% 
    const sectionIcons = {
      assignments: { icon: 'clipboard-list', labelClass: 'text-violet-400', badge: 'bg-violet-500/20 text-violet-300 border-violet-500/30' },
      notes: { icon: 'book-open', labelClass: 'text-cyan-400', badge: 'bg-cyan-500/20 text-cyan-300 border-cyan-500/30' },
      quizzes: { icon: 'help-circle', labelClass: 'text-amber-400', badge: 'bg-amber-500/20 text-amber-300 border-amber-500/30' },
      miscellaneous: { icon: 'bell', labelClass: 'text-rose-400', badge: 'bg-rose-500/20 text-rose-300 border-rose-500/30' }
    };
  %>

  <% sections.forEach(section => { %>
    <% const cfg = sectionIcons[section.key] || sectionIcons.miscellaneous; %>
    <section class="space-y-3">
<div class="flex items-center justify-between pb-2 border-b border-surface-border/70">
<div class="flex items-center gap-2.5">
<i class="w-5 h-5 <%= cfg.labelClass %>" data-lucide="<%= cfg.icon %>"></i>
<h3 class="text-base font-bold text-white tracking-wide"><%= section.label %></h3>
<span class="text-xs px-2 py-0.5 rounded-full font-semibold border <%= cfg.badge %>">
            <%= section.tasks.length %>
          </span>
</div>
<span class="text-[11px] font-mono uppercase tracking-wider text-slate-500">
          <% if(section.key === 'assignments') { %>Coursework Deliverables<% } %>
          <% if(section.key === 'notes') { %>Handouts & Transcripts<% } %>
          <% if(section.key === 'quizzes') { %>Timed Assessments<% } %>
          <% if(section.key === 'miscellaneous') { %>Administrative & General<% } %>
        </span>
</div>

      <% if (section.tasks.length === 0) { %>
        <div class="p-6 rounded-xl bg-surface-card/40 border border-surface-border/40 text-center text-slate-500 text-xs">
          No active items in <%= section.label.toLowerCase() %>.
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 gap-3">
          <% section.tasks.forEach(task => { %>
            <div class="p-4 rounded-xl bg-surface-card border border-surface-border hover:border-surface-highlight transition-all shadow-md group flex flex-col md:flex-row md:items-center justify-between gap-4" id="task-<%= task.id %>">
<div class="space-y-1.5 flex-1 min-w-0">
<div class="flex flex-wrap items-center gap-2 text-xs">
<!-- Source Origin -->
<span class="inline-flex items-center gap-1 font-medium text-slate-400">
<i class="w-3.5 h-3.5 text-accent-cyan" data-lucide="<%= task.source === 'gmail' ? 'mail' : 'graduation-cap' %>"></i>
                    <%= task.source === 'gmail' ? 'Gmail' : 'Google Classroom' %>
                  </span>
                  
                  <% if (task.subject) { %>
                    <span class="text-slate-500">•</span>
<span class="px-2 py-0.5 rounded bg-surface-low border border-surface-border text-slate-300 font-mono text-[11px]">
                      <%= task.subject %>
                    </span>
                  <% } %>

                  <% if (task.faculty) { %>
                    <span class="text-slate-500">•</span>
<span class="text-slate-400 text-xs"><%= task.faculty %></span>
                  <% } %>

                  <% if (task.due_date) { %>
                    <span class="text-slate-500">•</span>
<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-rose-500/15 text-rose-300 border border-rose-500/30">
<i class="w-3 h-3" data-lucide="clock"></i>
                      Due: <%= task.due_date %>
                    </span>
                  <% } else { %>
                    <span class="text-slate-500">•</span>
<span class="text-[11px] text-slate-500">No Due Date</span>
                  <% } %>
                </div>
<h4 class="text-sm font-semibold text-white group-hover:text-primary transition-colors">
                  <%= task.title %>
                </h4>

                <% if (task.snippet) { %>
                  <p class="text-xs text-slate-400 line-clamp-2"><%= task.snippet %></p>
                <% } %>
              </div>
<!-- Action Buttons -->
<div class="flex items-center gap-2 shrink-0 self-end md:self-center">
                <% if (task.link) { %>
                  <a class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-low hover:bg-surface-border text-slate-300 hover:text-white border border-surface-border text-xs font-medium transition-colors" href="<%= task.link %>" target="_blank">
<i class="w-3.5 h-3.5" data-lucide="external-link"></i>
<span>Open Source</span>
</a>
                <% } %>

                <button class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-low hover:bg-emerald-500/20 text-slate-300 hover:text-emerald-300 border border-surface-border hover:border-emerald-500/40 text-xs font-medium transition-colors" onclick="markTaskDone(<%= task.id %>)">
<i class="w-3.5 h-3.5 text-emerald-400" data-lucide="check-circle-2"></i>
<span>Mark Done</span>
</button>
</div>
</div>
          <% }) %>
        </div>
      <% } %>
    </section>
  <% }) %>
</div>
<script>
  function setSort(val) {
    document.getElementById('sortInput').value = val;
    document.getElementById('filterForm').submit();
  }

  function copyNtfyTopic(topic) {
    navigator.clipboard.writeText(topic);
    alert('Copied ntfy topic: ' + topic);
  }

  async function markTaskDone(taskId) {
    try {
      const res = await fetch(`/api/tasks/${taskId}/complete`, { method: 'POST' });
      const data = await res.json();
      if (data.ok) {
        const el = document.getElementById(`task-${taskId}`);
        if (el) {
          el.style.opacity = '0';
          el.style.transform = 'scale(0.95)';
          setTimeout(() => el.remove(), 250);
        }
      } else {
        alert('Could not complete task.');
      }
    } catch (e) {
      alert('Network error marking task done.');
    }
  }
</script>

<%- include('partials/footer') %>
