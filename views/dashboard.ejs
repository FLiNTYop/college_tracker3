<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>College Tracker — Dashboard</title>
  <style>
    :root {
      --bg: #0f1115;
      --panel: #171a21;
      --panel-2: #1e222b;
      --border: #2a2f3a;
      --text: #e8eaed;
      --muted: #9aa1ac;
      --accent: #5b8cff;
      --red: #ff5c5c;
      --amber: #ffb020;
      --green: #3ecf8e;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
    }

    /* ---------- Top bar ---------- */
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 20px;
      background: var(--panel);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 10;
    }
    .topbar h1 { font-size: 18px; margin: 0; }
    .topbar .who { color: var(--muted); font-size: 13px; margin-top: 2px; }
    .topbar-actions { display: flex; gap: 8px; align-items: center; }
    .btn {
      background: var(--accent);
      color: white;
      border: none;
      padding: 8px 14px;
      border-radius: 8px;
      font-size: 13px;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
    }
    .btn.secondary {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text);
    }
    .btn:active { transform: scale(0.97); }

    /* ---------- Mobile tab switcher (hidden on desktop) ---------- */
    .tabbar {
      display: none;
      overflow-x: auto;
      gap: 6px;
      padding: 10px 12px;
      background: var(--panel);
      border-bottom: 1px solid var(--border);
    }
    .tabbar button {
      flex: 0 0 auto;
      background: var(--panel-2);
      border: 1px solid var(--border);
      color: var(--muted);
      padding: 8px 14px;
      border-radius: 20px;
      font-size: 13px;
      white-space: nowrap;
      cursor: pointer;
    }
    .tabbar button.active {
      background: var(--accent);
      color: white;
      border-color: var(--accent);
    }

    /* ---------- Sort / filter bar ---------- */
    .filterbar {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
      padding: 10px 16px;
      background: var(--panel);
      border-bottom: 1px solid var(--border);
    }
    .filterbar label { font-size: 12px; color: var(--muted); display: flex; align-items: center; gap: 6px; }
    .filterbar select {
      background: var(--panel-2);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 6px 10px;
      font-size: 13px;
      max-width: 200px;
    }
    .filterbar .reset { font-size: 12px; color: var(--accent); text-decoration: none; }
    .tag {
      display: inline-block;
      font-size: 11px;
      padding: 2px 8px;
      border-radius: 999px;
      background: var(--panel);
      color: var(--muted);
      border: 1px solid var(--border);
      margin: 0 4px 6px 0;
    }
    .tag.subject { color: var(--accent); border-color: rgba(91,140,255,0.4); }

    /* ---------- Board (columns) ---------- */
    .board {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
      padding: 16px;
      align-items: start;
    }
    .column {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 12px;
      display: flex;
      flex-direction: column;
      max-height: calc(100vh - 90px);
    }
    .column-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 14px;
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      background: var(--panel);
      border-radius: 12px 12px 0 0;
    }
    .column-header h2 {
      font-size: 14px;
      margin: 0;
      letter-spacing: 0.3px;
    }
    .count-badge {
      background: var(--panel-2);
      color: var(--muted);
      font-size: 12px;
      padding: 2px 9px;
      border-radius: 999px;
    }
    .column-body {
      padding: 10px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .empty-hint {
      color: var(--muted);
      font-size: 13px;
      text-align: center;
      padding: 24px 8px;
    }

    /* ---------- Task card ---------- */
    .card {
      background: var(--panel-2);
      border: 1px solid var(--border);
      border-left: 3px solid var(--border);
      border-radius: 10px;
      padding: 10px 12px;
    }
    .card.overdue { border-left-color: var(--red); }
    .card.today   { border-left-color: var(--amber); }
    .card.upcoming{ border-left-color: var(--green); }

    .card-title {
      font-size: 13.5px;
      font-weight: 600;
      margin: 0 0 4px 0;
      line-height: 1.35;
    }
    .card-meta {
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 6px;
    }
    .due-pill {
      display: inline-block;
      font-size: 11px;
      padding: 2px 8px;
      border-radius: 999px;
      margin-bottom: 6px;
    }
    .due-pill.overdue { background: rgba(255,92,92,0.15); color: var(--red); }
    .due-pill.today   { background: rgba(255,176,32,0.15); color: var(--amber); }
    .due-pill.upcoming{ background: rgba(62,207,142,0.15); color: var(--green); }
    .due-pill.none    { background: var(--panel); color: var(--muted); }

    .card-detail {
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 8px;
      max-height: 54px;
      overflow: hidden;
    }
    .card-actions {
      display: flex;
      gap: 8px;
    }
    .card-actions a, .card-actions button {
      font-size: 12px;
      padding: 5px 10px;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: transparent;
      color: var(--text);
      text-decoration: none;
      cursor: pointer;
    }
    .card-actions .done-btn {
      background: var(--green);
      border-color: var(--green);
      color: #0f1115;
      font-weight: 600;
    }

    /* ---------- Responsive: phone gets tabs, one column visible ---------- */
    @media (max-width: 860px) {
      .tabbar { display: flex; }
      .board {
        grid-template-columns: 1fr;
        padding: 10px;
      }
      .column { display: none; max-height: none; }
      .column.active { display: flex; }
    }
  </style>
</head>
<body>

  <div class="topbar">
    <div>
      <h1>College Tracker</h1>
      <div class="who"><%= user.email %></div>
    </div>
    <div class="topbar-actions">
      <button class="btn secondary" id="scanBtn">Scan now</button>
      <a class="btn secondary" href="/logout">Logout</a>
    </div>
  </div>

  <!-- Tabs only appear on small screens; JS toggles which .column has .active -->
  <div class="tabbar" id="tabbar">
    <% sections.forEach(function(section, i) { %>
      <button data-target="col-<%= section.key %>" class="<%= i === 0 ? 'active' : '' %>">
        <%= section.label %> (<%= section.tasks.length %>)
      </button>
    <% }); %>
  </div>

  <!-- Sort + filter: plain GET form, no JS needed -->
  <form class="filterbar" method="get" action="/dashboard">
    <label>Sort by
      <select name="sort" onchange="this.form.submit()">
        <option value="due" <%= sort === 'due' ? 'selected' : '' %>>Due date</option>
        <option value="subject" <%= sort === 'subject' ? 'selected' : '' %>>Subject</option>
        <option value="faculty" <%= sort === 'faculty' ? 'selected' : '' %>>Faculty</option>
      </select>
    </label>
    <label>Subject
      <select name="subject" onchange="this.form.submit()">
        <option value="">All subjects</option>
        <% subjects.forEach(function(sub) { %>
          <option value="<%= sub %>" <%= subjectFilter === sub ? 'selected' : '' %>><%= sub %></option>
        <% }); %>
      </select>
    </label>
    <label>Faculty
      <select name="faculty" onchange="this.form.submit()">
        <option value="">All faculty</option>
        <% faculties.forEach(function(f) { %>
          <option value="<%= f %>" <%= facultyFilter === f ? 'selected' : '' %>><%= f %></option>
        <% }); %>
      </select>
    </label>
    <% if (sort !== 'due' || subjectFilter || facultyFilter) { %>
      <a class="reset" href="/dashboard">Reset</a>
    <% } %>
  </form>

  <div class="board">
    <% sections.forEach(function(section, i) { %>
      <div class="column <%= i === 0 ? 'active' : '' %>" id="col-<%= section.key %>">
        <div class="column-header">
          <h2><%= section.label %></h2>
          <span class="count-badge"><%= section.tasks.length %></span>
        </div>
        <div class="column-body">
          <% if (section.tasks.length === 0) { %>
            <div class="empty-hint">Nothing here yet.</div>
          <% } %>

          <% section.tasks.forEach(function(task) { %>
            <%
              // Figure out urgency bucket in plain JS (no library needed)
              var urgency = 'none';
              if (task.due_date) {
                var today = new Date();
                today.setHours(0,0,0,0);
                var due = new Date(task.due_date);
                due.setHours(0,0,0,0);
                var diffDays = Math.round((due - today) / 86400000);
                if (diffDays < 0) urgency = 'overdue';
                else if (diffDays === 0) urgency = 'today';
                else urgency = 'upcoming';
              }
            %>
            <div class="card <%= urgency %>" data-task-id="<%= task.id %>">
              <% if (task.due_date) { %>
                <span class="due-pill <%= urgency %>">
                  <% if (urgency === 'overdue') { %>Overdue · <%= task.due_date %>
                  <% } else if (urgency === 'today') { %>Due today
                  <% } else { %>Due <%= task.due_date %>
                  <% } %>
                </span>
              <% } else { %>
                <span class="due-pill none">No due date</span>
              <% } %>

              <% if (task.subject || task.faculty) { %>
                <div>
                  <% if (task.subject) { %><span class="tag subject"><%= task.subject %></span><% } %>
                  <% if (task.faculty) { %><span class="tag"><%= task.faculty %></span><% } %>
                </div>
              <% } %>
              <p class="card-title"><%= task.title %></p>
              <% if (!task.subject && !task.faculty) { %>
                <div class="card-meta"><%= task.course_or_sender || '' %></div>
              <% } %>

              <% if (task.detail) { %>
                <div class="card-detail"><%= task.detail %></div>
              <% } %>

              <div class="card-actions">
                <% if (task.link) { %>
                  <a href="<%= task.link %>" target="_blank" rel="noopener">Open</a>
                <% } %>
                <button class="done-btn" onclick="markDone('<%= task.id %>', this)">Done</button>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    <% }); %>
  </div>

  <script>
    // ---- Mobile tab switching ----
    document.querySelectorAll('#tabbar button').forEach(function (btn) {
      btn.addEventListener('click', function () {
        document.querySelectorAll('#tabbar button').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.column').forEach(c => c.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById(btn.dataset.target).classList.add('active');
      });
    });

    // ---- Mark a task as done ----
    async function markDone(taskId, btnEl) {
      btnEl.disabled = true;
      btnEl.textContent = '...';
      try {
        const res = await fetch(`/api/tasks/${taskId}/complete`, { method: 'POST' });
        if (res.ok) {
          const card = btnEl.closest('.card');
          card.remove();
        } else {
          btnEl.textContent = 'Done';
          btnEl.disabled = false;
        }
      } catch (err) {
        btnEl.textContent = 'Done';
        btnEl.disabled = false;
      }
    }

    // ---- Scan now button ----
    document.getElementById('scanBtn').addEventListener('click', async function () {
      const btn = this;
      btn.disabled = true;
      btn.textContent = 'Scanning...';
      try {
        await fetch('/api/scan-now', { method: 'POST' });
        location.reload();
      } catch (err) {
        btn.disabled = false;
        btn.textContent = 'Scan now';
      }
    });
  </script>

</body>
</html>
