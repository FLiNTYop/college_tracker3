<%- include('partials/header', { title: 'Calendar - College Tracker', activeTab: 'calendar', user: user }) %>

<div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
<div>
<div class="flex items-center gap-2">
<span class="inline-block w-2 h-2 rounded-full bg-accent-cyan animate-pulse"></span>
<span class="text-xs font-mono uppercase text-accent-cyan tracking-wider font-semibold">LIVE ACADEMIC FEED ACTIVE</span>
</div>
<h1 class="text-2xl font-bold text-white mt-1">Academic Due Dates Calendar</h1>
<p class="text-xs text-slate-400">Aggregated deadlines synced automatically from your Gmail and Google Classroom feeds.</p>
</div>
<!-- Legend -->
<div class="flex flex-wrap items-center gap-3 text-xs bg-surface-card p-2.5 rounded-xl border border-surface-border">
<span class="font-mono uppercase text-[10px] text-slate-400">CLASSIFICATION:</span>
<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-violet-500"></span> Assignments</span>
<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span> Quizzes</span>
<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-cyan-500"></span> Notes</span>
<span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> Projects/Misc</span>
</div>
</div>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
<!-- Month Grid (8 Columns) -->
<div class="lg:col-span-8 bg-surface-card rounded-2xl border border-surface-border p-5 shadow-xl">
<div class="flex items-center justify-between mb-4">
<div class="flex items-center gap-3">
<button class="p-1.5 rounded-lg bg-surface-low border border-surface-border hover:text-white text-slate-400" id="prevMonthBtn">
<i class="w-4 h-4" data-lucide="chevron-left"></i>
</button>
<h2 class="text-base font-bold text-white font-mono" id="calendarMonthTitle">Current Month</h2>
<button class="p-1.5 rounded-lg bg-surface-low border border-surface-border hover:text-white text-slate-400" id="nextMonthBtn">
<i class="w-4 h-4" data-lucide="chevron-right"></i>
</button>
</div>
<div class="flex items-center gap-1 bg-surface-low p-1 rounded-lg border border-surface-border text-xs">
<button class="px-2.5 py-1 rounded font-medium bg-primary text-white">Month</button>
</div>
</div>
<!-- Day of Week Headers -->
<div class="grid grid-cols-7 gap-1 text-center font-mono text-[11px] text-slate-400 mb-2">
<div>SUN</div><div>MON</div><div>TUE</div><div>WED</div><div>THU</div><div>FRI</div><div>SAT</div>
</div>
<!-- Days Container -->
<div class="grid grid-cols-7 gap-1 min-h-[420px]" id="calendarDaysGrid">
<!-- Populated via JS -->
</div>
</div>
<!-- Upcoming Timeline (4 Columns) -->
<div class="lg:col-span-4 space-y-4">
<!-- ntfy status widget -->
<div class="p-4 rounded-xl bg-surface-card border border-surface-border flex items-center justify-between">
<div class="flex items-center gap-3">
<div class="w-8 h-8 rounded-lg bg-accent-amber/15 text-accent-amber flex items-center justify-center border border-accent-amber/30">
<i class="w-4 h-4" data-lucide="bell-ring"></i>
</div>
<div>
<div class="text-xs font-bold text-white flex items-center gap-1.5">
            ntfy Alerts Configured
            <span class="w-1.5 h-1.5 rounded-full bg-accent-cyan"></span>
</div>
<p class="text-[11px] text-slate-400">Push notification scheduled for 24h & 2h prior.</p>
</div>
</div>
</div>
<!-- Upcoming List -->
<div class="p-4 rounded-xl bg-surface-card border border-surface-border space-y-3">
<div class="flex items-center justify-between pb-2 border-b border-surface-border">
<div class="flex items-center gap-2">
<i class="w-4 h-4 text-primary" data-lucide="calendar"></i>
<h3 class="text-sm font-bold text-white">Upcoming Timeline</h3>
</div>
<span class="text-xs px-2 py-0.5 rounded-full font-mono bg-primary/20 text-primary border border-primary/30">
          <%= tasks.length %> DUE
        </span>
</div>
<div class="space-y-2.5 max-h-[500px] overflow-y-auto pr-1">
        <% if (tasks.length === 0) { %>
          <p class="text-xs text-slate-500 text-center py-6">No scheduled deadlines.</p>
        <% } else { %>
          <% tasks.forEach(task => { %>
            <div class="p-3 rounded-lg bg-surface-low border border-surface-border/70 hover:border-surface-highlight transition-all space-y-1.5" id="timeline-<%= task.id %>">
<div class="flex items-center justify-between gap-2">
<span class="text-[11px] font-mono text-slate-400 flex items-center gap-1">
<span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                  <%= task.due_date %>
                </span>
<span class="text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-surface-card border border-surface-border text-slate-300">
                  <%= task.category || 'misc' %>
                </span>
</div>
<h4 class="text-xs font-semibold text-white leading-tight"><%= task.title %></h4>
<div class="flex items-center justify-between pt-1">
<span class="text-[11px] text-slate-400 font-mono"><%= task.subject || '' %></span>
<div class="flex items-center gap-1.5">
                  <% if (task.link) { %>
                    <a class="text-[11px] text-primary hover:underline flex items-center gap-0.5" href="<%= task.link %>" target="_blank">
                      Link <i class="w-3 h-3" data-lucide="arrow-up-right"></i>
</a>
                  <% } %>
                  <button class="text-[11px] text-slate-400 hover:text-emerald-400 ml-2" onclick="markTaskDone(<%= task.id %>)">
                    Done
                  </button>
</div>
</div>
</div>
          <% }) %>
        <% } %>
      </div>
</div>
</div>
</div>
<!-- Data injection for calendar month view -->
<script>
  window.CALENDAR_TASKS = <%- JSON.stringify(tasks) %>;
</script>
<script src="/js/calendar.js"></script>

<%- include('partials/footer') %>
